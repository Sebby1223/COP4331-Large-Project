# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- API (apps/api) ---
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (include the database name)
MONGODB_URI=
# Long random string used to sign JWTs: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
# Optional: JWT lifetime (default 30m)
ACCESS_TOKEN_EXPIRES_IN=30m
# Resend API key (resend.com -> API Keys, "Sending access"). Leave empty locally: emails print to the console instead.
# Required in production. Never commit the real key.
RESEND_API_KEY=
# Sender; the domain must be verified in Resend, e.g. Country Guesser <noreply@your-domain.com>
MAIL_FROM=
# Web app URL used in email links (prod: https://your-domain.com; default http://localhost:5173)
APP_URL=

# --- Web (apps/web) -- only VITE_* vars are exposed to the browser ---
# URL of the deployed API, e.g. http://your-domain.com:5000 (defaults to http://localhost:5000)
VITE_API_URL=http://localhost:5000
